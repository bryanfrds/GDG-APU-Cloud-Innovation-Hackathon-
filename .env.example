# Copy to .env.local and fill in. Never commit .env.local.
# Server-only: never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=

# Python submissions service only. Leave unset to keep SQLite and the local uploads/ folder (development).
# Set to "gcp" to store files in the GCS_BUCKET bucket and records in Firestore. Needs GCS_BUCKET and
# GOOGLE_CLOUD_PROJECT above, plus credentials (locally: gcloud auth application-default login).
PROVE_IT_STORE=

# Optional. Set on any public deployment so only people with the code can start a viva.
DEMO_PASSCODE=

# Optional. Where saved vivas are written (default .data/vivas). On Cloud Run use /tmp/vivas and
# --max-instances=1 until storage moves to Firestore; the disk is wiped when an instance stops.
VIVA_DATA_DIR=

# Optional but needed on any hosted deployment: Upstash Redis, so saved vivas are shared by every
# server copy and survive restarts. Vercel's Upstash integration sets these for you. When unset,
# vivas are saved as files under VIVA_DATA_DIR instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Base URL of the Python submissions service (for example https://prove-it-api.example.com). When set,
# the viva starts from a saved submission's questions and client-written plans are refused.
# Server-only. The service must be started with the same DEMO_PASSCODE.
PROVE_IT_API_URL=

# Optional. Gemini text model for writing questions and scoring (default gemini-3.5-flash; busy models fall back).
GEMINI_MODEL=
